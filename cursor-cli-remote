# If Tailscale IP is penalty-blocked, switch FORGE_HOST to LAN direct IP.
forge_try_lan_fallback() {
  local lan why="${FORGE_TCP_WHY:-}"
  [[ "$why" == *"Not allowed at this time"* ]] || return 1
  [[ "$FORGE_HOST" == 100.* ]] || return 1
  lan=$(forge_lan_host "$REMOTE") || return 1
  [[ -n "$lan" && "$lan" != "$FORGE_HOST" ]] || return 1
  flog "ensure_forge: Tailscale $FORGE_HOST blocked — fallback LAN $lan"
  FORGE_HOST="$lan"
  return 0
}

