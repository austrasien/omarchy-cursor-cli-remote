yubikey_present() {
  local f
  for f in /sys/bus/usb/devices/*/idVendor; do
    [[ -f "$f" ]] || continue
    [[ "$(<"$f")" == "1050" ]] && return 0
  done
  for f in /sys/bus/usb/devices/*/product; do
    [[ -f "$f" ]] || continue
    [[ "$(<"$f")" == *[Yy]ubi[Kk]ey* ]] && return 0
  done
  return 1
}

wait_should_quit() {
  local st="${1:-0}"
  ((st == 130))
}

ssh_master_ok() {
  ssh -O check "$REMOTE" >/dev/null 2>&1
}

# ControlMaster forks inside Foot's gtk-launch/uwsm scope. When the window
# closes, systemd kills the mux and the next launch asks for the YubiKey
# again. Move it onto a delegated user service (Delegate=yes is required
# for AttachProcessesToUnit).
#
# Mux lifetime (explicit policy):
#   1) Hard cutoff 04:00 local — ssh-forge-close.timer + Match expire script
#   2) ControlPersist=${MUX_PERSIST} — safety net if the timer missed (suspend)
# Closing Foot must NOT kill the mux (rehome_mux). Failure is logged + warned.
MUX_UNIT="ssh-${REMOTE}-mux.service"

# ssh -O check only means the local mux process exists. After suspend,
# Tailscale blips, or forge reboot, the socket stays up while the tunnel
# is dead — and ConnectTimeout often does not apply through ControlMaster.
# External timeout + a cheap remote true is the real liveness check.
ssh_master_alive() {
  local tries="${1:-1}" i=0
  ssh_master_ok || return 1
  while ((i < tries)); do
    if command -v timeout >/dev/null 2>&1; then
      timeout 6 ssh -o BatchMode=yes -o ConnectTimeout=5 \
        -o ServerAliveInterval=2 -o ServerAliveCountMax=1 \
        "$REMOTE" true >/dev/null 2>&1 && return 0
    else
      SSH_ASKPASS_REQUIRE=never ssh -o BatchMode=yes -o ConnectTimeout=5 \
        -o ServerAliveInterval=2 -o ServerAliveCountMax=1 \
        "$REMOTE" true >/dev/null 2>&1 && return 0
    fi
    i=$((i + 1))
    ((i < tries)) && sleep 1
  done
  return 1
}

kill_mux() {
  flog "kill_mux remote=$REMOTE unit=$MUX_UNIT"
  ssh -O exit "$REMOTE" >/dev/null 2>&1 || true
  systemctl --user stop "$MUX_UNIT" >/dev/null 2>&1 || true
  if [[ -n "${FORGE_CONTROL:-}" ]]; then
    rm -f "$FORGE_CONTROL"
  fi
  MUX_REHOME_WARN=""
}

drop_stale_master() {
  if ssh_master_ok; then
    return 0
  fi
  # Mux process gone (network drop, sshd restart) but the sleep-infinity
  # babysitter unit may still be up — clean without implying user error.
  if [[ -n "${FORGE_CONTROL:-}" && -S "${FORGE_CONTROL:-}" ]] \
    || systemctl --user is-active --quiet "$MUX_UNIT" 2>/dev/null; then
    flog "drop_stale_master: mux process gone — clean socket/unit"
  fi
  kill_mux
  return 0
}

mux_pid_for_socket() {
  python3 -c '
import os, sys
sock = os.path.realpath(sys.argv[1])

def pids():
    for name in os.listdir("/proc"):
        if name.isdigit():
            yield name

for pid in pids():
    fd_dir = "/proc/%s/fd" % pid
    try:
        fds = os.listdir(fd_dir)
    except OSError:
        continue
    for fd in fds:
        try:
            link = os.readlink(os.path.join(fd_dir, fd))
        except OSError:
            continue
        if link == sock:
            print(pid)
            raise SystemExit(0)
        if link.startswith("/") and os.path.realpath(link) == sock:
            print(pid)
            raise SystemExit(0)

inode = None
try:
    with open("/proc/net/unix") as fh:
        next(fh, None)
        for line in fh:
            parts = line.split()
            if len(parts) >= 8 and os.path.realpath(parts[-1]) == sock:
                inode = parts[6]
                break
except OSError:
    pass
if inode:
    needle = "socket:[%s]" % inode
    for pid in pids():
        fd_dir = "/proc/%s/fd" % pid
        try:
            fds = os.listdir(fd_dir)
        except OSError:
            continue
        for fd in fds:
            try:
                if os.readlink(os.path.join(fd_dir, fd)) == needle:
                    print(pid)
                    raise SystemExit(0)
            except OSError:
                continue

needle = sock.encode()
for pid in pids():
    try:
        with open("/proc/%s/cmdline" % pid, "rb") as fh:
            cmd = fh.read().replace(b"\0", b" ")
    except OSError:
        continue
    if needle in cmd and b"mux" in cmd:
        print(pid)
        raise SystemExit(0)
raise SystemExit(1)
' "$1" 2>/dev/null
}

ensure_mux_unit() {
  local unit="$1" out st=0
  systemctl --user is-active --quiet "$unit" && return 0
  systemctl --user reset-failed "$unit" 2>/dev/null || true
  # Race / leftover transient: unit fragment exists but is inactive → start it
  # instead of failing systemd-run with "already loaded or has a fragment file".
  if systemctl --user cat "$unit" >/dev/null 2>&1; then
    if systemctl --user start "$unit" >/dev/null 2>&1 \
      && systemctl --user is-active --quiet "$unit"; then
      flog "ensure_mux_unit: started existing $unit"
      return 0
    fi
    systemctl --user stop "$unit" >/dev/null 2>&1 || true
    systemctl --user reset-failed "$unit" 2>/dev/null || true
  fi
  out=$(systemd-run --user --quiet --collect \
    --unit="$unit" \
    --property=Delegate=yes \
    --property=Slice=app.slice \
    /usr/bin/sleep infinity 2>&1)
  st=$?
  if ((st != 0)); then
    # Parallel resume + launcher: peer may have won the create race.
    if systemctl --user is-active --quiet "$unit"; then
      flog "ensure_mux_unit: race won by peer — $unit active"
      return 0
    fi
    if systemctl --user start "$unit" >/dev/null 2>&1 \
      && systemctl --user is-active --quiet "$unit"; then
      flog "ensure_mux_unit: start after systemd-run fail — $unit"
      return 0
    fi
    flog "ensure_mux_unit fail unit=$unit st=$st out=$out"
    return 1
  fi
  systemctl --user is-active --quiet "$unit"
}

mux_in_unit() {
  local pid="$1" unit="$2"
  [[ -r "/proc/${pid}/cgroup" ]] || return 1
  grep -q "/${unit}$" "/proc/${pid}/cgroup" 2>/dev/null
}

rehome_mux() {
  local sock pid unit="$MUX_UNIT" out st=0 cg=""
  sock="${FORGE_CONTROL:-}"
  if [[ -z "$sock" || ! -S "$sock" ]]; then
    flog "rehome_mux skip: no control socket (${sock:-empty})"
    return 0
  fi
  if ! command -v busctl >/dev/null 2>&1; then
    MUX_REHOME_WARN="busctl absent"
    flog "rehome_mux fail: busctl missing — mux stays in Foot cgroup"
    return 1
  fi
  pid="$(mux_pid_for_socket "$sock")"
  st=$?
  if ((st != 0)) || [[ -z "$pid" ]]; then
    MUX_REHOME_WARN="PID mux introuvable"
    flog "rehome_mux fail: mux pid not found for $sock"
    return 1
  fi
  if mux_in_unit "$pid" "$unit"; then
    MUX_REHOME_WARN=""
    flog "rehome_mux ok: already in $unit pid=$pid"
    return 0
  fi
  if ! ensure_mux_unit "$unit"; then
    MUX_REHOME_WARN="unit $unit KO"
    flog "rehome_mux fail: ensure_mux_unit $unit"
    return 1
  fi
  out=$(busctl --user call org.freedesktop.systemd1 /org/freedesktop/systemd1 \
    org.freedesktop.systemd1.Manager AttachProcessesToUnit \
    ssau "$unit" / 1 "$pid" 2>&1)
  st=$?
  if ((st != 0)); then
    MUX_REHOME_WARN="attach mux KO"
    flog "rehome_mux fail: AttachProcessesToUnit st=$st pid=$pid out=$out"
    return 1
  fi
  sleep 0.05 || true
  if ! mux_in_unit "$pid" "$unit"; then
    cg="$(tr '\n' ' ' <"/proc/${pid}/cgroup" 2>/dev/null | head -c 240 || true)"
    MUX_REHOME_WARN="mux encore dans Foot"
    flog "rehome_mux fail: cgroup verify pid=$pid not in $unit cg=$cg"
    return 1
  fi
  MUX_REHOME_WARN=""
  flog "rehome_mux ok: pid=$pid -> $unit (survive Foot close; PIN again after 04:00)"
  return 0
}

warn_mux_rehome() {
  local detail="${MUX_REHOME_WARN:-rehome échoué}"
  flog "warn_mux_rehome: $detail"
  {
    printf '\n'
    if command -v gum >/dev/null; then
      gum style --foreground "$ACCENT" --padding "0 1" \
        "⚠ Mux SSH pas détaché de Foot (${detail})."
      gum style --faint --foreground "$MUTED" \
        "Fermer cette fenêtre redemandera la YubiKey. Log: $LOG_FILE"
      gum style --faint --foreground "$MUTED" "Entrée pour continuer…"
    else
      printf 'Mux SSH pas détaché de Foot (%s).\nLog: %s\nEntrée…\n' \
        "$detail" "$LOG_FILE"
    fi
  } >/dev/tty 2>/dev/null || true
  read -r _ </dev/tty || true
}

draw_wait() {
  local sub="$1"
  local body="${2:-$YUBI_BODY}"
  local auto_yubi="${3:-1}"
  local hint st
  if [[ "$auto_yubi" == 1 ]]; then
    hint="reprise auto dès la clé     q×2  fermer (pas Esc — OTP)"
  else
    hint="Entrée  réessayer     esc×2 (lent)  fermer"
  fi
  restore_tty
  AUTO_YUBI="$auto_yubi" MODE=wait TITLE="$WINDOW_TITLE" SUB="$sub" \
    HINT="$hint" \
    BODY="$body" \
    ACCENT="$ACCENT" FG="$FG" MUTED="$MUTED" BG="$BG" \
    run_tui wait </dev/null >/dev/tty
  st=$?
  flog "draw_wait auto_yubi=$auto_yubi sub=$sub exit=$st"
  # Never set -e before this return: wait exit 130/1 is normal control flow.
  return "$st"
}

