print(f"{key}  {stamp}  {dot}  {task}    {tag}\t{name}")
' "$1" "$2" "$3" "$4" "$5"
}

header_sub() {
  local count="${1:-}" extra="${2:-}"
  local sub="${REMOTE}  ·  persist"
  if [[ "$count" == loading ]]; then
    sub+="  ·  connexion…"
  elif [[ -n "$count" ]]; then
    if ((count == 0)); then
      sub+="  ·  aucune session"
    else
      local noun="session"
      ((count > 1)) && noun="sessions"
      sub+="  ·  ${count} ${noun}"
    fi
  fi
  # Mux policy: reuse until 04:00 local (timer + Match expire); ControlPersist is backup.
  if [[ "$count" != loading ]] && ssh_master_ok 2>/dev/null; then
    sub+="  ·  mux → 04:00"
  fi
  if [[ -n "${MUX_REHOME_WARN:-}" ]]; then
    sub+="  ·  ⚠ mux Foot"
  fi
  if [[ -n "$extra" ]]; then
    sub+="  ·  ${extra}"
  fi
  printf '%s' "$sub"
}

